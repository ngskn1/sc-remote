# coturn relay, for networks where the two PCs can't reach each other directly (strict firewalls, some
# mobile/university networks). Install: sudo apt install coturn; copy this to /etc/turnserver.conf; open
# UDP/TCP 3478 and UDP 49160-49200 in the firewall; sudo systemctl enable --now coturn.
# In the lab rules: TURN relay URLs = turn:turn.example.org:3478, user/password as below.
listening-port=3478
fingerprint
lt-cred-mech
user=lab:change-this-password
realm=turn.example.org
min-port=49160
max-port=49200
no-cli
no-tlsv1
no-tlsv1_1
# don't relay into private networks (keeps the relay from being used to reach your LAN)
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
